<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Sim.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Исключение из «никаких NuGet в Sim.Core» (ADR-0001): анализатор времени компиляции, в рантайм не попадает. -->
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.0.0" PrivateAssets="all" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)../../BannedSymbols.txt" Link="BannedSymbols.txt" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Sim.Core.Tests" />
    <InternalsVisibleTo Include="Sim.Bench" />
    <InternalsVisibleTo Include="Sim.Headless" />
  </ItemGroup>

</Project>
