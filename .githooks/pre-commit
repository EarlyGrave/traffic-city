#!/usr/bin/env bash
# Pre-commit: формат, сборка без предупреждений, юнит-тесты. Работает в Linux и Git Bash.
set -u

cd "$(git rev-parse --show-toplevel)" || exit 1

# Коммит только из документации (*.md в любом каталоге, docs/**, CLAUDE.md) — проверки не нужны.
# Пустой список (например, merge-коммит) — проверки запускаются как обычно.
docs_only=1
staged_count=0
while IFS= read -r -d '' staged_file; do
  staged_count=$((staged_count + 1))
  case "$staged_file" in
    *.md | docs/* | CLAUDE.md) ;;
    *) docs_only=0 ;;
  esac
done < <(git diff --cached --name-only -z --diff-filter=ACMRD)
if [ "$staged_count" -gt 0 ] && [ "$docs_only" -eq 1 ]; then
  echo "pre-commit: только документация, проверки пропущены"
  exit 0
fi

fail() {
  echo "" >&2
  echo "pre-commit: ОТКАЗ — $1" >&2
  echo "Исправь проблему и повтори коммит (обход: git commit --no-verify — только осознанно)." >&2
  exit 1
}

# Режим прототипа (CLAUDE.md, «Режим прототипа»): только сборка, без format и тестов.
if [ -f .claude/prototype-mode ]; then
  echo "pre-commit: dotnet build -warnaserror"
  dotnet build traffic-city.sln -warnaserror --nologo -v q || fail "сборка упала или есть предупреждения"
  echo "pre-commit: режим прототипа — только сборка"
  exit 0
fi

echo "pre-commit: dotnet format --verify-no-changes"
dotnet format traffic-city.sln --verify-no-changes || fail "форматирование не соответствует .editorconfig (запусти: dotnet format traffic-city.sln)"

echo "pre-commit: dotnet build -warnaserror"
dotnet build traffic-city.sln -warnaserror --nologo -v q || fail "сборка упала или есть предупреждения"

echo "pre-commit: dotnet test"
dotnet test traffic-city.sln --no-build --nologo -v q || fail "юнит-тесты не проходят"

echo "pre-commit: ok"
